# Template for your personal .env file. This file is safe to commit; it holds no real keys.
#
# Setup:  copy this file to a new file named exactly ".env" (keep this one as-is),
#         then fill in your own values in .env. Git ignores .env, so it never gets pushed.
#
# Format: NAME=value   (no spaces around "=", no quotes needed)

API_KEY=your-api-key-here
API_EMAIL=you@umich.edu
